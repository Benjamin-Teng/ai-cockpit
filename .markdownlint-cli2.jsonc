{
  // CJK 散文專案慣例：關行長與表格 pipe 對齊，其餘保留
  "config": {
    "MD013": false,
    "MD060": false,
    // 不同章節下允許同名小節（例如 §19 與 §27 都有 "Runtime"）
    "MD024": { "siblings_only": true }
  },
  // .claude/ 與 .agents/ 內是 openspec init 產生的 skill 檔，不由本 repo 維護；
  // .superpowers/ 是 SDD 的本地 scratch（git exclude），不進 lint
  "ignores": ["target/**", "node_modules/**", ".claude/**", ".agents/**", ".superpowers/**"]
}
